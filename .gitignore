# dependencies and build output
node_modules/
dist/
.wrangler/

# one package manager (pnpm, pinned in package.json): never commit another
# manager's lockfile — pnpm-lock.yaml is the only lockfile in this repo
package-lock.json
yarn.lock
bun.lock
bun.lockb

# local secrets (commit the *.example files instead)
.dev.vars*
!.dev.vars.example
.env
.env.*
!.env.example

# test artefacts
coverage/
playwright-report/
test-results/
blob-report/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
